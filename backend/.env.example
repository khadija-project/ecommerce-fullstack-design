# Set to "true" to use MongoDB (Atlas or local). Set to "false" to use the
# built-in JSON file database (great for quick local testing / no DB install).
USE_MONGO=false

# Only needed when USE_MONGO=true. Get a free cluster at mongodb.com/atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ecommerce

PORT=5000
JWT_SECRET=replace_this_with_a_long_random_secret_string

# The email you sign up with that matches this value is auto-promoted to "admin"
FIRST_ADMIN_EMAIL=admin@example.com
